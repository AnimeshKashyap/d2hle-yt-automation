# Copy to .env or set in docker-compose
DATA_ROOT=./data
HTTP_ADDR=127.0.0.1:8081
MAX_CONCURRENT_JOBS=1
HEADLESS=true
ALLOWED_MEDIA_ROOTS=./data/media,E:\development\Dota 2\dota2-hle-be\output
# Comma-separated; set to require Authorization: Bearer <token> on mutating routes
# API_TOKEN=
LOG_LEVEL=info
STUDIO_URL=https://studio.youtube.com
BROWSER_LAUNCH_TIMEOUT=3m
BROWSER_NAV_TIMEOUT=90s
LOGIN_WAIT_TIMEOUT=15m
# Set false in Docker; use CLI on host for headed login
INTERACTIVE_LOGIN=true
# Use installed Google Chrome for login (required for Google sign-in; Playwright Chromium is often blocked)
BROWSER_CHANNEL=chrome
# Optional full path if Chrome is not on PATH
# BROWSER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
BROWSER_STEALTH=true
# Session probe uses headed Chrome by default (matches login). Set true only in headless-only environments.
SESSION_CHECK_HEADLESS=false
# Morning session warm-up (headed Chrome; visits Studio + youtube.com). Not OAuth refresh tokens.
SESSION_REFRESH_HEADLESS=false
SESSION_REFRESH_TIMEOUT=10m
SESSION_REFRESH_DWELL=5s
UPLOAD_HEADLESS=false
UPLOAD_JOB_TIMEOUT=6m # 120m
# Per-click/fill timeout in Studio (avoid using 90s nav timeout on optional fields)
STUDIO_ACTION_TIMEOUT=10s
# Max wait for upload dialog after selecting file (large videos); polls every 300ms
UPLOAD_UI_WAIT_TIMEOUT=6m # 120m
# Per-step ceilings (fail fast; whole job still capped by UPLOAD_JOB_TIMEOUT)
STUDIO_STEP_OPEN_STUDIO_TIMEOUT=30s
STUDIO_STEP_UPLOAD_DIALOG_TIMEOUT=30s
STUDIO_STEP_METADATA_TIMEOUT=60s
STUDIO_STEP_WIZARD_TIMEOUT=30s
STUDIO_STEP_PUBLISH_TIMEOUT=30s
STUDIO_STEP_VERIFY_TIMEOUT=30s