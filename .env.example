# Template — copy to `.env` and edit. `.env` overrides OS environment variables when the binary runs.
# See README "Configuration" for precedence and lookup order (cwd `.env`, then beside the executable).

# --- Storage & HTTP ---
# Root for profiles, jobs, staging, and default media folder (created on first run).
DATA_ROOT=./data
# Bind host/port for `d2hle-yt serve`. Use HTTP_HOST=0.0.0.0 to listen on all interfaces (LAN).
HTTP_HOST=127.0.0.1
HTTP_PORT=8081
# Legacy single variable (used only when HTTP_HOST and HTTP_PORT are unset):
# HTTP_ADDR=127.0.0.1:8081
# Max upload jobs running at once (each job uses one browser profile lock).
MAX_CONCURRENT_JOBS=1
# Comma-separated directories; API/CLI video paths must resolve under one of these.
ALLOWED_MEDIA_ROOTS=./data/media,E:\path\to\optional\render-output

# --- API auth (optional) ---
# If set, mutating routes require: Authorization: Bearer <token>
# API_TOKEN=changeme-use-a-long-random-secret

# --- Logging & Studio ---
LOG_LEVEL=info
STUDIO_URL=https://studio.youtube.com

# --- Browser (Playwright + Chrome) ---
# Default headless for generic/legacy flag; login/upload often use the flags below instead.
HEADLESS=true
BROWSER_LAUNCH_TIMEOUT=3m
BROWSER_NAV_TIMEOUT=90s
LOGIN_WAIT_TIMEOUT=15m
# Set false in Docker; on Windows host use true for `profile login`.
INTERACTIVE_LOGIN=true
# Use installed Google Chrome (required for reliable Google sign-in).
BROWSER_CHANNEL=chrome
# Uncomment if Chrome is not on PATH:
# BROWSER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
BROWSER_STEALTH=true

# --- Session check / refresh (headed by default on Windows) ---
# Headless probes often look logged-out even with valid cookies.
SESSION_CHECK_HEADLESS=false
# Morning warm-up: Studio + youtube.com in a headed browser (not OAuth refresh tokens).
SESSION_REFRESH_HEADLESS=false
SESSION_REFRESH_TIMEOUT=10m
SESSION_REFRESH_DWELL=5s

# --- Upload behavior ---
# Match how you completed `profile login` (headed vs headless).
UPLOAD_HEADLESS=false
# Whole-job ceiling; increase for long encodes/uploads.
UPLOAD_JOB_TIMEOUT=120m
# Per-click/fill in Studio (avoid using nav timeout on optional fields).
STUDIO_ACTION_TIMEOUT=10s
# Wait for upload UI after selecting the file (large videos).
UPLOAD_UI_WAIT_TIMEOUT=120m

# --- Per-step ceilings (fail fast; job still capped by UPLOAD_JOB_TIMEOUT) ---
STUDIO_STEP_OPEN_STUDIO_TIMEOUT=30s
STUDIO_STEP_UPLOAD_DIALOG_TIMEOUT=30s
STUDIO_STEP_METADATA_TIMEOUT=60s
STUDIO_STEP_WIZARD_TIMEOUT=30s
STUDIO_STEP_PUBLISH_TIMEOUT=30s
STUDIO_STEP_VERIFY_TIMEOUT=30s
